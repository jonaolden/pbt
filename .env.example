# Snowflake connection credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=my_username

# Authentication. Default is SSO (externalbrowser). If SNOWFLAKE_AUTHENTICATOR is unset it is inferred:
# PASSWORD -> snowflake, PRIVATE_KEY_FILE -> snowflake_jwt, TOKEN -> oauth, otherwise externalbrowser.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser   # externalbrowser | snowflake | snowflake_jwt | username_password_mfa
#                                           # | oauth | programmatic_access_token | workload_identity
# SNOWFLAKE_PASSWORD=my_secure_password                      # snowflake, username_password_mfa
# SNOWFLAKE_PASSCODE=123456                                  # username_password_mfa (omit for push approval)
# SNOWFLAKE_PRIVATE_KEY_FILE=~/.ssh/snowflake_rsa_key.p8     # snowflake_jwt
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=                          # snowflake_jwt, encrypted key only
# SNOWFLAKE_TOKEN=                                           # oauth, programmatic_access_token

# Optional connection defaults
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYST_ROLE
