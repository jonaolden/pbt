# Dummy Snowflake settings for the sample project.
# Copy to .env and fill in real values. NEVER commit .env.
# SNOWFLAKE_ACCOUNT / SNOWFLAKE_WAREHOUSE are used by `pbt build` (snowflake_config.yaml).
# All of them are read by the metadata lookup in `pbt generate-tables`.

SNOWFLAKE_ACCOUNT=myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_USER=my_username
SNOWFLAKE_PASSWORD=my_secure_password
SNOWFLAKE_ROLE=ANALYST_ROLE
